---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Course } from '../data/courses';
import Icon from './Icon.astro';
interface Props {
  course: Course;
  save?: boolean;
}
const { course, save = true } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/img/cursos/*.png', {
  eager: true,
});
const photo = images[`../assets/img/cursos/${course.image}`].default;
---

<article
  class="course-card"
  data-course-card
  data-category={course.category}
  data-name={course.name}
>
  <div class="course-photo">
    <a href={`/cursos/${course.slug}/`} tabindex="-1" aria-hidden="true">
      <Image
        src={photo}
        alt=""
        widths={[320, 480, 640]}
        sizes="(max-width: 600px) 90vw, (max-width: 1000px) 45vw, 24vw"
        width={480}
        height={350}
        format="webp"
        loading="lazy"
      />
    </a>
    <span class="course-category">{course.category}</span>
    {save && (
      <button
        class="save-course"
        data-save-course={course.slug}
        aria-label={`Guardar ${course.name}`}
        aria-pressed="false"
      >
        <Icon name="heart" size={18} />
      </button>
    )}
  </div>
  <div class="course-content">
    <h3>
      <a href={`/cursos/${course.slug}/`}>{course.name}</a>
    </h3>
    <p>{course.description}</p>
    <a class="course-link" href={`/cursos/${course.slug}/`}>
      Conocer el curso <Icon name="diagonal" size={18} />
    </a>
  </div>
</article>
