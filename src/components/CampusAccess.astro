---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<aside class="campus-strip" aria-label="Acceso para alumnos">
  <div class="container campus-strip-inner">
    <div class="campus-strip-copy">
      <Icon name="laptop" size={21} />
      <p>
        <strong>¿Sos alumno?</strong> <span>Accedé al campus para gestionar tus clases y más.</span>
      </p>
    </div>
    {site.studentCampus ? (
      <a href={site.studentCampus} target="_blank" rel="noopener noreferrer">
        Ingresar al campus <Icon name="diagonal" size={16} />
      </a>
    ) : (
      <button type="button" disabled title="Falta configurar la dirección del campus de alumnos">
        Ingresar al campus <Icon name="diagonal" size={16} />
      </button>
    )}
  </div>
</aside>
<style>
  .campus-strip {
    background: #002898;
    color: #fff;
    padding: 12px 0;
  }
  .campus-strip-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .campus-strip-copy {
    display: flex;
    align-items: center;
    gap: 13px;
  }
  .campus-strip-copy > svg {
    flex-shrink: 0;
  }
  .campus-strip p {
    color: #fff;
    font-size: 12px;
    line-height: 1.6;
    margin: 0;
  }
  .campus-strip strong {
    font-weight: 800;
    margin-right: 7px;
  }
  .campus-strip a,
  .campus-strip button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-shrink: 0;
    background: #fff;
    color: #002898;
    border: 1px solid #fff;
    border-radius: 50px;
    padding: 9px 17px;
    font-size: 11px;
    font-weight: 800;
    line-height: 1.5;
    text-decoration: none;
  }
  .campus-strip a:hover {
    background: #edf1ff;
  }
  .campus-strip button:disabled {
    cursor: not-allowed;
  }
  .campus-strip a:focus-visible {
    outline: 3px solid white;
    outline-offset: 4px;
  }
  @media (max-width: 760px) {
    .campus-strip {
      padding: 14px 0;
    }
    .campus-strip-inner {
      align-items: flex-start;
      gap: 12px;
      flex-direction: column;
    }
    .campus-strip-copy {
      gap: 10px;
    }
    .campus-strip p {
      font-size: 11px;
    }
    .campus-strip strong {
      display: block;
      font-size: 13px;
      margin-bottom: 2px;
    }
    .campus-strip a,
    .campus-strip button {
      margin-left: 31px;
      font-size: 11px;
      padding: 8px 15px;
    }
  }
</style>
