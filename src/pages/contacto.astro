---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, whatsapp } from '../data/site';
import '../styles/secondary.css';
---

<BaseLayout
  title="Contacto y consultas | Tu Capacitación"
  description="Consultá por cursos, modalidades e inscripciones en Tu Capacitación. WhatsApp, correo y atención en Santiago del Estero, 25 de Mayo 54."
>
  <section class="secondary-hero">
    <div class="container">
      <nav class="secondary-breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span>Contacto</span>
      </nav>
      <p class="eyebrow">ESTAMOS CERCA</p>
      <h1>
        Tu próximo paso
        <br />
        empieza <em>con una charla.</em>
      </h1>
      <p class="secondary-lead">
        Preguntá, contanos qué te interesa y despejá tus dudas. Te ayudamos a encontrar una
        formación para vos.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container secondary-split">
      <div class="secondary-copy">
        <p class="eyebrow">HABLEMOS</p>
        <h2>
          Elegí cómo
          <br />
          acercarte.
        </h2>
        <dl class="secondary-detail-list">
          <div>
            <dt>WhatsApp</dt>
            <dd>
              <a
                href={whatsapp('Hola, quiero hacer una consulta sobre Tu Capacitación.')}
                target="_blank"
                rel="noopener noreferrer"
              >
                {site.phoneDisplay} <span aria-hidden="true">↗</span>
              </a>
            </dd>
          </div>
          <div>
            <dt>Correo electrónico</dt>
            <dd>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </dd>
          </div>
          <div>
            <dt>Encontranos</dt>
            <dd>
              {site.address}
              <br />
              {site.city}
              <br />
              <a class="text-link" href="/sedes/">
                Cómo llegar <span aria-hidden="true">→</span>
              </a>
            </dd>
          </div>
        </dl>
        <p class="eyebrow">SEGUÍ NUESTRAS NOVEDADES</p>
        <div class="secondary-socials">
          <a href={site.instagram} target="_blank" rel="noopener noreferrer">
            Instagram ↗
          </a>
          <a href={site.facebook} target="_blank" rel="noopener noreferrer">
            Facebook ↗
          </a>
          <a href={site.tiktok} target="_blank" rel="noopener noreferrer">
            TikTok ↗
          </a>
          <a href={site.youtube} target="_blank" rel="noopener noreferrer">
            YouTube ↗
          </a>
        </div>
      </div>
      <div class="secondary-panel">
        <h2>Contanos qué tenés en mente.</h2>
        <p>
          Completá tu consulta. Abriremos WhatsApp con el mensaje listo para que lo revises y
          envíes.
        </p>
        <form id="contactForm" class="secondary-form" data-whatsapp-phone={site.phone}>
          <div class="secondary-field">
            <label for="contact-name">Nombre completo *</label>
            <input
              id="contact-name"
              name="name"
              autocomplete="name"
              placeholder="Tu nombre y apellido"
              required
              minlength="2"
              maxlength="100"
            />
          </div>
          <div class="secondary-field">
            <label for="contact-email">Correo electrónico *</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="tu@email.com"
              required
              maxlength="150"
            />
          </div>
          <div class="secondary-field">
            <label for="contact-area">Área de interés *</label>
            <select id="contact-area" name="area" required>
              <option value="" disabled selected>
                Elegí un área
              </option>
              <option>Administrativa</option>
              <option>Técnica</option>
              <option>Informática</option>
              <option>Belleza</option>
              <option>Salud</option>
              <option>Otra consulta</option>
            </select>
          </div>
          <div class="secondary-field">
            <label for="contact-message">Tu consulta *</label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              placeholder="¿Qué te gustaría saber?"
              required
              minlength="5"
              maxlength="2000"
            ></textarea>
          </div>
          <p class="secondary-note">
            * Campos obligatorios. Los datos se incorporan al mensaje de WhatsApp. La consulta se
            envía cuando vos lo confirmás allí.
          </p>
          <button class="button button-primary" type="submit" id="contact-submit" disabled>
            Continuar en WhatsApp <span aria-hidden="true">↗</span>
          </button>
          <noscript>
            <p class="secondary-note">
              Para usar el formulario activá JavaScript, o{' '}
              <a href={whatsapp('Hola, quiero hacer una consulta sobre Tu Capacitación.')}>
                escribinos directamente por WhatsApp
              </a>
              .
            </p>
          </noscript>
          <div class="secondary-form-status" id="contact-status" role="status" hidden>
            <p>
              Tu consulta está preparada. Revisala y enviala en WhatsApp para completar el contacto.
            </p>
            <a
              id="contact-fallback"
              href={whatsapp('Hola, quiero hacer una consulta sobre Tu Capacitación.')}
              target="_blank"
              rel="noopener noreferrer"
            >
              Abrir el mensaje en WhatsApp ↗
            </a>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#contactForm');
  const submit = document.querySelector<HTMLButtonElement>('#contact-submit');
  if (form && submit) {
    submit.disabled = false;
    form.addEventListener('input', (event) => {
      const field = event.target;
      if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement)
        field.setCustomValidity('');
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      for (const field of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        'input, textarea',
      )) {
        if (!field.value.trim()) {
          field.setCustomValidity('Completá este campo.');
          field.reportValidity();
          return;
        }
      }
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const value = (name: string) => String(data.get(name) || '').trim();
      const message = `Hola, soy ${value('name')}.\nCorreo: ${value('email')}\nÁrea de interés: ${value('area')}\n\nConsulta: ${value('message')}`;
      const phone = (form.dataset.whatsappPhone || '').replace(/\D/g, '');
      const url = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
      const fallback = document.querySelector<HTMLAnchorElement>('#contact-fallback');
      const status = document.querySelector<HTMLElement>('#contact-status');
      if (fallback) fallback.href = url;
      if (status) status.hidden = false;
      window.open(url, '_blank', 'noopener,noreferrer');
    });
  }
</script>
