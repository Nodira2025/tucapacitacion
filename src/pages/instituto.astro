---
import BaseLayout from '../layouts/BaseLayout.astro';
import { whatsapp } from '../data/site';
import '../styles/secondary.css';

const modalities = [
  {
    name: 'Presencial',
    description: [
      'Clases presenciales una vez por semana, con cupos reducidos. Consultá la sede disponible para tu curso.',
      'Consultas al docente a través del grupo de WhatsApp.',
      'Material de estudio en la plataforma virtual.',
      'Soporte presencial y en línea durante el cursado.',
    ],
  },
  {
    name: 'Semipresencial',
    description: [
      'Encuentros en vivo por Zoom una vez por semana.',
      'Clases grabadas para volver a verlas si no podés asistir.',
      'Consultas al docente por WhatsApp y material de estudio en la plataforma virtual.',
      'Soporte presencial y en línea durante el cursado.',
    ],
  },
  {
    name: 'A distancia',
    description: [
      'Material de estudio disponible las 24 horas para cursar a tu ritmo.',
      'Trabajos prácticos por unidad en Flexy Quiz y un evaluativo por módulo.',
      'Consultas al docente por la plataforma.',
      'Asistencia administrativa y acompañamiento durante el cursado.',
    ],
  },
];
---

<BaseLayout
  title="Conocé el instituto | Tu Capacitación"
  description="Conocé Tu Capacitación, instituto de formación laboral en Santiago del Estero. Cursos prácticos, modalidades presencial, semipresencial y a distancia."
>
  <section class="secondary-hero">
    <div class="container">
      <nav class="secondary-breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span>El instituto</span>
      </nav>
      <p class="eyebrow">EL INSTITUTO · SANTIAGO DEL ESTERO</p>
      <h1>
        Creemos en lo que
        <br />
        podés <em>llegar a hacer.</em>
      </h1>
      <p class="secondary-lead">
        La formación es ese primer paso que abre nuevas posibilidades. Estamos para acompañarte a
        darlo.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container secondary-split">
      <div class="institute-statement">
        <span class="eyebrow">NUESTRA FORMA DE ENSEÑAR</span>
        <p>
          Aprender.
          <br />
          Practicar.
          <br />
          <span>Animarte a más.</span>
        </p>
      </div>
      <div class="secondary-copy">
        <p class="eyebrow">FORMACIÓN QUE SE ACERCA A VOS</p>
        <h2>
          Herramientas para
          <br />
          tu próximo paso.
        </h2>
        <p>
          En Tu Capacitación trabajamos para acercar una formación práctica a las personas de
          Santiago del Estero. Nuestro equipo dicta cursos y carreras cortas de forma presencial y
          virtual.
        </p>
        <p>
          El enfoque está en aprender haciendo: desarrollar conocimientos y habilidades que puedas
          llevar a la vida profesional, con material de estudio y acompañamiento durante el
          recorrido.
        </p>
        <div class="secondary-actions">
          <a class="button button-primary" href="/cursos/">
            Encontrá tu curso <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="/contacto/">
            Conversemos <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="section" aria-labelledby="modalidades-title">
    <div class="container">
      <p class="eyebrow">DISTINTAS FORMAS DE EMPEZAR</p>
      <h2 id="modalidades-title">
        Tu vida tiene un ritmo.
        <br />
        Tu formación también.
      </h2>
      <p class="secondary-lead">
        Conocé cómo se cursa en cada modalidad. La disponibilidad depende del curso que elijas.
      </p>
      <div class="modality-grid">
        {modalities.map((modality, i) => (
          <article class="modality-card">
            <span class="modality-number" aria-hidden="true">
              0{i + 1}
            </span>
            <h3>{modality.name}</h3>
            <ul>
              {modality.description.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <p class="secondary-note">
        Antes de inscribirte, consultá modalidad, sede, horarios, aranceles y tipo de certificación
        del curso. Podés leer las <a href="/terminos-y-condiciones/">condiciones de cursado</a>.
      </p>
    </div>
  </section>
  <div class="container">
    <section class="secondary-bottom">
      <div>
        <h2>Hay un comienzo para vos.</h2>
        <p>Te ayudamos a encontrar el curso que estás buscando.</p>
      </div>
      <a
        class="button button-primary"
        href={whatsapp('Hola, quiero conocer las modalidades y cursos de Tu Capacitación.')}
        target="_blank"
        rel="noopener noreferrer"
      >
        Hablemos por WhatsApp <span aria-hidden="true">↗</span>
      </a>
    </section>
  </div>
</BaseLayout>
